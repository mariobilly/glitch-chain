{
  "name": "glitch-chain",
  "productName": "Glitch Chain",
  "version": "0.1.0",
  "description": "Real-time analog glitch chain: stretch-tear, font layer, tape rot, CRT.",
  "main": "./out/main/index.js",
  "author": "Mario Schebly",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "build:win": "electron-vite build && electron-builder --win",
    "postinstall": "install-electron --no && node scripts/get-models.mjs",
    "models": "node scripts/get-models.mjs",
    "test:e2e": "node tests/ui.e2e.mjs"
  },
  "build": {
    "appId": "com.mariobilly.glitchchain",
    "productName": "Glitch Chain",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "fileAssociations": [
      {
        "ext": "glitch",
        "name": "Glitch Chain Project",
        "description": "Glitch Chain project",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ]
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@huggingface/transformers": "^4.3.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "ffmpeg-static": "^5.3.0",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^26.6.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
